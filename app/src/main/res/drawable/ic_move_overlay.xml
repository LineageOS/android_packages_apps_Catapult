<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:height="@dimen/favorite_card_height">
        <shape android:shape="rectangle">
            <solid android:color="#80000000" />
            <corners android:radius="@dimen/favorite_card_radius" />
        </shape>
    </item>

    <item
        android:width="49dp"
        android:height="60dp"
        android:drawable="@drawable/ic_arrow_left"
        android:gravity="center"
        android:right="60dp" />

    <item
        android:width="49dp"
        android:height="60dp"
        android:drawable="@drawable/ic_arrow_right"
        android:gravity="center"
        android:left="85dp" />
</layer-list>
